---
import { generateToc } from "@/utils/generateToc";
import { localeFrom, t } from "@/i18n";
import type { MarkdownHeading } from "astro";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateToc(headings);
const lang = localeFrom(Astro.currentLocale);
---

<details open class="xl:sticky xl:top-12 xl:col-start-2 xl:row-start-1 xl:self-start">
	<summary class="title hover:marker:text-accent cursor-pointer text-lg">{t(lang, "post.toc")}</summary>
	<nav
		class="ms-4 lg:w-full xl:max-h-[calc(100vh-8rem)] xl:overflow-y-auto xl:overscroll-contain xl:pe-2 [scrollbar-width:thin]"
	>
		<ol class="mt-4">
			{toc.map((heading) => <TOCHeading heading={heading} />)}
		</ol>
	</nav>
</details>
