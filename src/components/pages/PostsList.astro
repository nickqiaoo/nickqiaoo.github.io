---
// 博客列表页正文：按年份分组的文章，右侧是标签。
import type { CollectionEntry } from "astro:content";
import Pagination from "@/components/Paginator.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { groupPostsByYear } from "@/data/post";
import { type Lang, langPrefix, t, tagPath, tagsPath } from "@/i18n";
import type { Page } from "astro";
import { Icon } from "astro-icon/components";

interface Props {
	lang: Lang;
	page: Page<CollectionEntry<"post">>;
	uniqueTags: string[];
}
const { lang, page, uniqueTags } = Astro.props;

const paginationProps = {
	...(page.url.prev && { prevUrl: { text: t(lang, "page.prev"), url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: t(lang, "page.next"), url: page.url.next } }),
};

const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<div class="mb-6 flex items-center gap-3">
	<h1 class="title">{t(lang, "posts.title")}</h1>
	<a class="text-accent" href={`${langPrefix(lang)}/rss.xml`} target="_blank">
		<span class="sr-only">RSS feed</span>
		<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
	</a>
</div>
<div class="grid sm:grid-cols-[3fr_1fr] sm:gap-x-8 sm:gap-y-16">
	<div>
		{
			descYearKeys.map((yearKey) => (
				<section aria-labelledby={`year-${yearKey}`}>
					<h2 id={`year-${yearKey}`} class="title text-lg">
						<span class="sr-only">{t(lang, "posts.in")}</span>
						{yearKey}
					</h2>
					<ul class="mt-5 mb-16 space-y-6 text-start">
						{groupedByYear[yearKey]?.map((p) => (
							<li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
								<PostPreview post={p} />
							</li>
						))}
					</ul>
				</section>
			))
		}
		<Pagination {...paginationProps} />
	</div>
	{
		!!uniqueTags.length && (
			<aside>
				<h2 class="title mb-4 flex items-center gap-2 text-lg">
					{t(lang, "posts.tags")}
					<svg
						aria-hidden="true"
						class="h-6 w-6"
						fill="none"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1.5"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path d="M0 0h24v24H0z" fill="none" stroke="none" />
						<path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z" />
						<path d="M17.573 18.407l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-7.117 -7.116" />
						<path d="M6 9h-.01" />
					</svg>
				</h2>
				<ul class="flex flex-wrap gap-2">
					{uniqueTags.map((tag) => (
						<li>
							<a class="cactus-link flex items-center justify-center" href={tagPath(lang, tag)}>
								<span aria-hidden="true">#</span>
								<span class="sr-only">{t(lang, "tags.viewWith")}</span>
								{tag}
							</a>
						</li>
					))}
				</ul>
				<span class="mt-4 block sm:text-end">
					<a class="hover:text-link" href={tagsPath(lang)}>
						{t(lang, "posts.viewAll")} <span aria-hidden="true">→</span>
					</a>
				</span>
			</aside>
		)
	}
</div>
