---
import { localeFrom, t } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

const lang = localeFrom(Astro.currentLocale);
const meta = {
	description: t(lang, "404.desc"),
	title: t(lang, "404.title"),
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">404 | {t(lang, "404.title")}</h1>
	<p class="mb-8">{t(lang, "404.hint")}</p>
</PageLayout>
